{
  "name": "kart-admin-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run build:bff",
    "build:bff": "esbuild src/server.ts --bundle --platform=node --format=esm --sourcemap --outfile=dist/kart-admin-web/server/server.mjs --packages=external",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:bff": "vitest run --root src/server",
    "lint": "ng lint",
    "serve:bff": "node --env-file-if-exists=.env dist/kart-admin-web/server/server.mjs",
    "start-bff-server": "npm run build:bff && npm run serve:bff"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "cookie": "^2.0.1",
    "design-system": "file:vendor/design-system-0.0.1.tgz",
    "express": "^5.1.0",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "22.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.6.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.10"
  }
}
