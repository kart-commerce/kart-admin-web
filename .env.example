# Copy to .env and fill in for your environment. Loaded automatically by `npm run serve:bff`
# / `npm run start-bff-server` via node's --env-file-if-exists — no dotenv package needed.
# Never commit the real .env (already covered by .gitignore).
#
# Every URL below has a localhost:<port> fallback baked into its client, so a missing
# variable fails *silently* into "trying to reach a service that probably isn't running" —
# there's no crash, just an empty/degraded response. Set these explicitly for anything
# beyond one developer's local box.

# kart-identity-service (src/server/bff/identity-client.ts, analytics-client.ts)
# Port 8081 is kart-identity-service's own local dev port (its launchSettings.json http
# profile) — the same host port kart-devops/docker-compose.yml maps it to, so this works
# unchanged whether identity is running bare-metal or via the kart-devops stack.
IDENTITY_SERVICE_BASE_URL=http://localhost:8081

# The enterprise IdP alias this deployment federates Admin logins against (Okta/Azure AD/
# Google Workspace per the BRD) — src/server/bff/identity-client.ts
ENTERPRISE_IDP_ALIAS=okta

# kart-admin-service (src/server/bff/admin-service-client.ts). Port 8094 matches both
# kart-admin-service's own local dev port (its launchSettings.json http profile) and
# kart-devops/docker-compose.yml's host port for it. A failure here degrades to "no known
# grants" rather than breaking login, but is logged loudly (via src/server/logger.ts, see
# LOG_FILE_PATH below) so an unreachable/misconfigured URL stays visible.
ADMIN_SERVICE_BASE_URL=http://localhost:8094

# kart-analytics-service (src/server/bff/analytics-client.ts)
ANALYTICS_SERVICE_BASE_URL=http://localhost:5295
ANALYTICS_CLIENT_ID=
ANALYTICS_CLIENT_SECRET=

# kart-api-gateway base URL handed to the browser as app config (src/server/bff/routes.ts).
# Falls back to http://localhost:8100 (DEFAULT_APP_CONFIG in app-config.ts) when unset — the
# gateway's own local dev port, matching kart-devops/docker-compose.yml's host port for it.
GATEWAY_BASE_URL=

# Session store (src/server/bff/session-store.ts). Port 6380 is kart-devops/docker-compose.yml's
# host-mapped port for its shared Redis container (6379 is commonly already bound by a local
# Redis install) — point at 6379 instead if you're running your own standalone Redis.
REDIS_URL=redis://localhost:6380

# Standard Node/Express
NODE_ENV=development
PORT=4000

# Structured logging (src/server/logger.ts, pino) for the BFF's own outbound
# server-to-server calls (identity/analytics/admin-service clients) plus its
# global error boundary. Written to BOTH stdout and this file, full stack
# traces included.
#
# Follows the platform's kart-internals convention (kart-shared's
# Kart.Shared.Configuration/README.md — the same per-machine, gitignored,
# absolute-path pattern the .NET services use for their GlobalConfig file):
# a directory named kart-internals/<service-name>/ that each developer keeps
# outside every service's own repo. Point this at a mounted volume instead in
# any environment where the container filesystem doesn't survive a
# restart/redeploy.
LOG_FILE_PATH=/absolute/path/to/your/kart-internals/kart-admin-web/bff-server.log
LOG_LEVEL=info
